# Server
PORT=3000
PUBLIC_BASE_URL=https://your-ngrok-or-production-url.com
LEADS_FILE_PATH=./data/leads.json

# Vapi
VAPI_API_KEY=your_vapi_private_api_key
VAPI_ASSISTANT_ID=your_vapi_assistant_id
VAPI_PHONE_NUMBER_ID=your_vapi_phone_number_id
VAPI_BASE_URL=https://api.vapi.ai
VAPI_MOCK_CALLS=true

# Twilio WhatsApp
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
WHATSAPP_DRY_RUN=true

# Optional Google Calendar integration
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CALENDAR_ID=primary
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n"

# Business context used in prompts/messages
BUSINESS_NAME=Sri Velan Properties
BUSINESS_CALLBACK_NUMBER=+919876543210
BUSINESS_LOCATION=Chennai
DEFAULT_TIMEZONE=Asia/Kolkata
